{
  "name": "@kotobamichi/srs",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "FSRS scheduler settings shared by the web app (guest reviews) and the API.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  }
}
