{
  "name": "kotobamichi",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "KotobaMichi (言葉道) - Full-Stack Japanese Learning Platform",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@kotobamichi/web",
    "dev:api": "turbo run dev --filter=@kotobamichi/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
