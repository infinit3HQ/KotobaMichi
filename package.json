{
  "name": "kotobamichi-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "KotobaMichi (言葉道) - Full-Stack Japanese Learning Platform",
  "scripts": {
    "dev": "pnpm --filter kotobamichi-frontend dev",
    "dev:frontend": "pnpm --filter kotobamichi-frontend dev",
    "dev:backend": "pnpm --filter kotobamichi-backend start:dev",
    "build": "pnpm --parallel --filter kotobamichi-backend --filter kotobamichi-frontend build",
    "build:frontend": "pnpm --filter kotobamichi-frontend build",
    "build:backend": "pnpm --filter kotobamichi-backend build",
    "lint": "pnpm --parallel --filter kotobamichi-backend --filter kotobamichi-frontend lint",
    "test": "pnpm --parallel --filter kotobamichi-backend test"
  }
}
