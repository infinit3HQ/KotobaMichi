# Migration stage - lightweight Alpine image for running Drizzle migrations
FROM node:26.12.1-alpine AS migration

# Set working directory
WORKDIR /app

# Install pnpm and runtime utilities
RUN apk add --no-cache curl \
  && npm install -g pnpm@12.15.0

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.docker.yaml ./
RUN mv pnpm-workspace.docker.yaml pnpm-workspace.yaml

# Install dependencies (need drizzle-kit plus the pg driver)
RUN pnpm install --frozen-lockfile

# Copy TypeScript config files so any path aliases / compilerOptions are available
COPY tsconfig.json ./
COPY tsconfig.build.json ./

# Copy Drizzle config, migrations and schema for type references
COPY drizzle.config.ts ./drizzle.config.ts
COPY drizzle ./drizzle
COPY src/db ./src/db

# Create a non-root user
RUN addgroup -g 1001 -S nodejs \
  && adduser -S nestjs -u 1001

# Change ownership of the app directory to the non-root user
RUN chown -R nestjs:nodejs /app

# Switch to non-root user
USER nestjs

# Default command to run Drizzle migrations
CMD ["pnpm", "db:drizzle:migrate"]
