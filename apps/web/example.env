# This file contains environment variables for the KotobaMichi Frontend.
# For local development, copy this file to .env.local and fill in the values.
# On deployment platforms, these variables should be set in the environment.

# The base URL for the backend API.
# Example: http://localhost:3001/v1/
NEXT_PUBLIC_API_URL=

# The public URL of the frontend application.
# This is used for generating absolute URLs for sitemaps, robots.txt, etc.
# Example: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification code (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# PostHog (web + product analytics, error tracking). The project key has a default in
# src/lib/analytics/config.ts; set this to override it, or to "off" to disable tracking.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog cloud region, "us" (default) or "eu". Read at build time for the /ingest proxy.
NEXT_PUBLIC_POSTHOG_REGION=us
# Analytics is off under `next dev`; set to true to send events from local development.
NEXT_PUBLIC_POSTHOG_DEV=

# The port the frontend application will run on inside the Docker container.
# This is used in docker-compose files. Defaults to 8080 if not set.
FRONTEND_PORT=8080
